# =============================================================
# Kronos AI Trading Agent — Environment Variables Template
# Copy this to .env locally or set these in Railway Variables
# =============================================================

# --- Security ---------------------------------------------------
PIN=2003

# --- Trading Mode & Controls ------------------------------------
DEMO_MODE=true
FORCE_STOP=false
DAILY_TARGET_ENABLED=false
DAILY_TARGET=100.0
AUTO_EXECUTE_TRADES=true
TRADE_DURATION=60

# --- Kronos API (Modal Deployment) ------------------------------
KRONOS_API_URL=https://aman1-ranazonai--kronos-trading-api-fastapi-app.modal.run
LOOP_INTERVAL=300
TRADE_AMOUNT=70

# --- Olymp Trade WebSocket Authentication -----------------------
# Your Olymp Trade session JWT token (required for live candles & trade execution)
OLYMP_TOKEN=

# --- Supabase Database (Shared Persistence) ---------------------
SUPABASE_URL=https://dlhavswlsygbamwskdwv.supabase.co
SUPABASE_KEY=
SUPABASE_SECRET_KEY=

# --- Telegram Bot & Remote Control ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STATUS_INTERVAL=300
TELEGRAM_TRADE_POLL=30
RATE_LIMIT_PER_MIN=10

# --- Web Dashboard / Server -------------------------------------
PORT=5000
FLASK_DEBUG=false
